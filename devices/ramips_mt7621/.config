
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y

# 仅编译 HC5962
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_hiwifi_hc5962=y

# HC5962 为 32MB NAND，内核约 4MB，根文件系统分区约 28MB
CONFIG_TARGET_ROOTFS_PARTSIZE=28

# 默认安装的软件包
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=n
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_sing-box=y

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-timewol=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_tailscale=y
